  "rime_sanctum": {"name": "凜冬聖所", "biome": "snow", "danger": 5, "grid": 5, "layers": 3, "monsters": ["ice_wraith", "frost_troll", "frostbite_spider", "draugr"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "ebony_ingot", "healing_potion"], "loot_locked": [38, 55], "boss": {"enemy": "frost_archmage", "raw": true, "desc": "聖所深處的冰封大廳 —— 絕霜大法師立於永不消融的霜霧中央,凍麻與遲鈍自牠周身擴散。冰霜對牠毫無作用,反被牠盡數吸納。", "treasure": {"loot": ["frost_staff", "ebony_ingot", "filled_grand_soul_gem", "healing_potion", "ruby", {"gold": [300, 600]}]}}},
  "tempest_sanctum": {"name": "雷霆聖所", "biome": "swamp", "danger": 5, "grid": 5, "layers": 3, "monsters": ["wamasu", "will_o_wisp", "storm_atronach", "marsh_zombie"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "glow_dust", "healing_potion"], "loot_locked": [38, 55], "boss": {"enemy": "shock_archmage", "raw": true, "desc": "聖所頂端的雷暴穹頂 —— 轟雷大法師在不息的電弧間移形換位,快得讓人措手不及。電擊打在牠身上只會匯入牠的掌心。", "treasure": {"loot": ["storm_staff", "ebony_ingot", "filled_grand_soul_gem", "healing_potion", "ruby", {"gold": [300, 600]}]}}},
  "convergence_sanctum": {"name": "匯流聖所", "biome": "heartland", "danger": 6, "grid": 5, "layers": 3, "monsters": ["dremora", "daedroth", "storm_atronach", "gargoyle"], "loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "ebony_ingot", "healing_potion"], "loot_locked": [42, 60], "boss": {"enemy": "fused_archmage", "raw": true, "desc": "聖所最深的元素奇點 —— 火、冰、雷在三元合體大法師體內永無止息地撕咬。牠抗盡三系,任何單一真言都奈何不了牠;唯有超越元素本身,才能終結這場狂暴的融合。", "treasure": {"loot": ["staff_of_magnus", "daedra_heart", "filled_grand_soul_gem", "filled_grand_soul_gem", "healing_potion", "healing_potion", {"gold": [500, 900]}]}}},
  "garlas_malatar": {"name": "蓋拉斯瑪拉塔", "biome": "heartland", "danger": 5, "grid": 5, "layers": 3, "monsters": ["skeleton", "draugr", "will_o_wisp", "gargoyle", "dremora"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "glow_dust", "healing_potion"], "loot_locked": [38, 55], "boss": {"enemy": "umaril_the_unfeathered", "raw": true, "desc": "白石列柱沒入幽藍的威爾之光 —— 艾雷德古都最深處的王座廳,穹頂懸著早已熄滅的星辰水晶。王座上,不羽者烏瑪瑞爾披著湮滅重鑄的軀殼緩緩起身,雷光沿著牠斷裂的羽冠爬行。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ebony_sword", "ruby", "healing_potion", "healing_potion", {"gold": [300, 550]}]}}},
  "kvatch_undercroft": {"name": "凱瓦奇聖殿地窟", "biome": "heartland", "danger": 5, "grid": 5, "layers": 3, "monsters": ["skeleton", "draugr", "will_o_wisp", "necromancer_acolyte", "lich"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "ebony_ingot"], "loot_locked": [40, 58], "boss": {"enemy": "time_forsaken", "raw": true, "desc": "地窟最深處,一方逆行的沙漏在祭壇上永恆倒轉 —— 時之背棄者自枯朽的祭袍中睜開眼,牠截停的最後一刻在牠周身凝成不化的寒霜。奪回這座聖殿,將牠交還給牠背棄的死亡。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "healing_potion", {"gold": [200, 400]}]}}},
  "jerall_warhold": {"name": "傑拉山寨", "biome": "snow", "danger": 5, "grid": 5, "layers": 3, "monsters": ["bandit", "skeleton", "draugr", "ice_wraith", "frost_troll"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "ebony_ingot"], "loot_locked": [40, 58], "boss": {"enemy": "oathbreaker_warlord", "raw": true, "desc": "山寨最深的霜封大廳 —— 叛誓戰王據坐在劫掠來的王座上,斷裂的帝國軍旗垂在他身後,淬霜的巨斧橫在膝頭。他曾對人皇之神起誓守護山道,如今卻只認拳頭與恐懼。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "healing_potion", {"gold": [220, 420]}]}}},
  "cheydinhal_ossuary": {"name": "切迪納骸骨窖", "biome": "heartland", "danger": 5, "grid": 5, "layers": 3, "monsters": ["skeleton", "draugr", "marsh_zombie", "will_o_wisp", "necromancer_acolyte"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "ebony_ingot"], "loot_locked": [40, 58], "boss": {"enemy": "grave_tyrant", "raw": true, "desc": "骸骨窖最深的殮室 —— 一圈被強行喚醒的亡者跪伏在腐朽的祭壇前,掘墓死靈王立於中央,阿爾凱的輪迴符文在他腳下龜裂剝落。腐疫的甜腥氣息瀰漫,他抬起枯手,亡者的低鳴應聲而起。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "healing_potion", {"gold": [200, 400]}]}}},
  "skingrad_athenaeum": {"name": "史金格拉德祕典閣", "biome": "heartland", "danger": 5, "grid": 5, "layers": 3, "monsters": ["will_o_wisp", "gargoyle", "storm_atronach", "flame_atronach", "dremora"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "ebony_ingot"], "loot_locked": [40, 58], "boss": {"enemy": "heretic_magus", "raw": true, "desc": "祕典閣頂層的星象穹頂 —— 環壁的書架早已被無主的火焰燒得焦黑,被束縛的元素體在半空中悲鳴。叛智巫師懸浮於崩解的邏輯法陣中央,朱利安諾斯的智慧符文在他腳下寸寸碎裂,火與雷在他掌心無序地互相吞噬。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "healing_potion", {"gold": [200, 400]}]}}},
  "chorrol_daedric_rift": {"name": "切若爾湮獄裂隙", "biome": "heartland", "danger": 5, "grid": 5, "layers": 3, "monsters": ["dremora", "daedroth", "flame_atronach", "gargoyle", "storm_atronach"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "ebony_ingot"], "loot_locked": [40, 58], "boss": {"enemy": "daedric_tormentor", "raw": true, "desc": "裂隙最深處,湮滅的火光自地縫裡湧出,燒融了岩壁 —— 折磨者戴德拉盤踞在被牠擄來的受難者殘骸之間,焦黑的犄角低垂,那張嗤笑的臉朝你轉來。牠要的,是連你的慈悲一起碾碎。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "healing_potion", {"gold": [220, 420]}]}}},
  "niben_bandit_hold": {"name": "尼本河匪窟", "biome": "swamp", "danger": 5, "grid": 5, "layers": 3, "monsters": ["bandit", "mudcrab", "giant_spider", "swamp_leech", "jungle_toad"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "ebony_ingot"], "loot_locked": [40, 58], "boss": {"enemy": "avarice_tyrant", "raw": true, "desc": "匪窟最深的贓貨窖藏 —— 成堆劫掠來的商貨與生鏽的鎖鏈之間,貪婪暴君坐在金幣壘成的椅子上,苦工的呻吟自陰影裡傳來。他慢條斯理地擦拭淬毒的短刃,抬眼打量你身上還能榨出多少油水。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "gold_amulet", "healing_potion", {"gold": [320, 560]}]}}},
  "blighted_grove": {"name": "枯萎的聖林", "biome": "heartland", "danger": 5, "grid": 5, "layers": 3, "monsters": ["spriggan", "giant_spider", "jungle_toad", "will_o_wisp", "bog_troll"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "ebony_ingot"], "loot_locked": [40, 58], "boss": {"enemy": "blighted_matron", "raw": true, "desc": "聖林最深處那株千年的心木 —— 樹皮龜裂剝落,滲著黑膿般的枯萎;枯萎的林母自扭曲的枝幹間探出身來,蝕根在腐土下蠕動,孢子的甜腥氣息瀰漫。將這株心木的痛苦了結,讓風重新穿過樹冠。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "healing_potion", {"gold": [200, 400]}]}}},
  "bravil_drowned_crypt": {"name": "布拉維爾沉水地窟", "biome": "swamp", "danger": 5, "grid": 5, "layers": 3, "monsters": ["will_o_wisp", "dro_mathra_shade", "marsh_zombie", "ice_wraith", "skeleton"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "ebony_ingot"], "loot_locked": [40, 58], "boss": {"enemy": "grief_shade", "raw": true, "desc": "地窟最深的積水殮室 —— 半沉的棺槨在黑水裡漂浮,牆上刻滿了無人記得的名字。哀慟之影自水面凝形而起,把一城被遺忘的悲傷化作徹骨的寒意朝你壓來。讓這些哀傷歸於安息。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "healing_potion", {"gold": [200, 400]}]}}},
  "abecean_grotto": {"name": "阿比西亞海妖窟", "biome": "heartland", "danger": 5, "grid": 5, "layers": 3, "monsters": ["slaughterfish", "mudcrab", "will_o_wisp", "marsh_zombie", "harpy"], "loot": ["filled_greater_soul_gem", "filled_grand_soul_gem", "ruby", "healing_potion", "ebony_ingot"], "loot_locked": [40, 58], "boss": {"enemy": "beguiling_siren", "raw": true, "desc": "海蝕洞最深的礁潭 —— 潭水映著詭異的粼光,沉在水底的是一具具還帶著微笑的溺者。蠱惑海妖自水霧中浮現,以蒂貝拉的容顏對你唱起綺夢的歌。斬斷這場虛妄,讓那些沉溺者得以安息。", "treasure": {"loot": ["filled_grand_soul_gem", "filled_grand_soul_gem", "ruby", "gold_amulet", "healing_potion", {"gold": [200, 400]}]}}}
