          },
          "failure": {
            "text": "你誦錯了經緯的次第,暗影趁隙撲上,冰冷的爪掠過你的胸膛才悻悻退去。",
            "effects": [
              {
                "type": "damage",
                "amount": 8
              }
            ]
          }
        }
      }
    ]
  },
  "arcane_trials_rumor": {
