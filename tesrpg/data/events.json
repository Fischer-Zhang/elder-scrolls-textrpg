      {"text": "搜刮他的財物", "effects": [{"type": "gold", "amount": 25}, {"type": "infamy", "amount": 5},
                   {"type": "bounty", "amount": 40},
                   {"type": "message", "text": "你翻走了傷者的錢袋 —— 遠處似乎有人看見了。"}]},
      {"text": "視而不見地走開", "effects": [{"type": "message", "text": "你別過頭,加快了腳步。"}]}
    ]
