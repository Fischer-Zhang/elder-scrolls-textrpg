{
  "highwayman": {
    "weight": 5, "trigger": {"contexts": ["travel"]},
    "title": "攔路強盜", "text": "一名強盜從路旁松林閃出,擋住去路:「留下五十金,饒你一命。」",
    "options": [
      {"text": "乖乖付過路費", "requirements": {"gold_min": 50},
       "effects": [{"type": "gold", "amount": -50}, {"type": "message", "text": "你掏出金幣,強盜冷笑著放行。"}]},
      {"text": "出言威嚇(口才)",
       "check": {"skill": "speechcraft", "difficulty": 40,
                 "success": {"text": "你不動聲色地報出幾個名號,強盜臉色一變,悻悻退去。",
                             "effects": [{"type": "fame", "amount": 4}]},
                 "failure": {"text": "強盜被你激怒,拔刀撲來!",
                             "effects": [{"type": "combat", "creature": "bandit"}]}}},
      {"text": "拔劍相向", "effects": [{"type": "combat", "creature": "bandit"}]}
    ]
  },
  "injured_traveler": {
    "weight": 4, "trigger": {"contexts": ["travel"]},
    "title": "路旁傷者", "text": "一名旅人倒在路邊呻吟,腿上有道深可見骨的傷口。",
    "options": [
      {"text": "用治療藥水救他", "requirements": {"item": "minor_healing_potion"},
