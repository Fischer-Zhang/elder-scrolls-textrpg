                   {"type": "message", "text": "傷者感激涕零,塞給你一袋金幣作謝。"}]},
      {"text": "施捨幾枚金幣", "requirements": {"gold_min": 10},
       "effects": [{"type": "gold", "amount": -10}, {"type": "fame", "amount": 3},
